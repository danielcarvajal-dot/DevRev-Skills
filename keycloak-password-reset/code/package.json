{
  "name": "keycloak-password-reset-snap-in",
  "version": "1.0.0",
  "description": "DevRev snap-in that unlocks Keycloak accounts and sends password reset emails",
  "main": "./dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "build:watch": "tsc --watch",
    "prepackage": "npm run build",
    "package": "tar -cvzf build.tar.gz dist package.json package-lock.json .npmrc",
    "start": "ts-node src/main.ts",
    "start:watch": "nodemon src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": ["devrev", "snap-in", "keycloak", "password-reset"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-env": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.86",
    "@types/yargs": "17.0.33",
    "babel-jest": "29.7.0",
    "dotenv": "16.4.7",
    "jest": "29.7.0",
    "nodemon": "3.1.9",
    "rimraf": "5.0.10",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "yargs": "17.7.2"
  },
  "dependencies": {
    "@devrev/typescript-sdk": "1.1.77",
    "axios": "1.8.4"
  }
}
